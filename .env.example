# Server
PORT=4000
WEB_PORT=4001
WHATSAPP_PORT=4002

# ===================
# WhatsApp Cloud API
# ===================
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v22.0
WHATSAPP_VERIFY_TOKEN=your_verify_token

# ===================
# Telegram Bot API
# ===================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Optional: defaults to https://api.telegram.org
TELEGRAM_BASE_URL=

# ===================
# LLM / DeepSeek
# ===================
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
# Optional: custom base URL for OpenAI-compatible API
DEEPSEEK_BASE_URL=

# ===================
# MCP Agent
# ===================
# Optional: max steps for MCP agent (defaults to 8)
MCP_MAX_STEPS=8

# ===================
# Database
# ===================
DATABASE_URL=postgresql://wpbot:wpbot@localhost:4003/wpbot
DATABASE_READONLY_URL=postgresql://wpbot_readonly:wpbot_readonly@localhost:4003/wpbot