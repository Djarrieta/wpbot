# Health Check
curl -X GET http://localhost:4000/

# List All Items
curl -X GET http://localhost:4000/items

# Create Item
curl -X POST http://localhost:4000/items \
  -H "Content-Type: application/json" \
  -d '{"name": "Item2", "price": 20, "description": "description of item2"}'

# Get Item by ID
curl -X GET http://localhost:4000/items/1

# Update Item
curl -X PUT http://localhost:4000/items/1 \
  -H "Content-Type: application/json" \
  -d '{"name": "Updated Item", "quantity": 20}'

# Delete Item
curl -X DELETE http://localhost:4000/items/1

# Assistant (requires userId for conversation history)
curl -X POST http://localhost:4000/assistant \
  -H "Content-Type: application/json" \
  -d '{"message": "y ahora?", "userId": 1}'

# Chat History - List All
curl -X GET http://localhost:4000/chathistory

# Chat History - Get by ID
curl -X GET http://localhost:4000/chathistory/1
