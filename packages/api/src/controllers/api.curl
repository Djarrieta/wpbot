# Health Check
curl -X GET http://localhost:4000/

# Assistant (by userId - user is auto-created if not exists)
curl -X POST http://localhost:4000/assistant \
  -H "Content-Type: application/json" \
  -d '{"message": "crea una nueva orden item_id: 1, quantity: 5, date: 2026-03-20", "userId": 1}'

# Assistant (by email - user is auto-created if not exists)
curl -X POST http://localhost:4000/assistant \
  -H "Content-Type: application/json" \
  -d '{"message": "Hola", "email": "john@example.com", "name": "John Doe"}'

# Assistant with optional name (used when creating new user by userId)
curl -X POST http://localhost:4000/assistant \
  -H "Content-Type: application/json" \
  -d '{"message": "Hola", "userId": 123, "name": "John Doe"}'

# Get or create user by email
curl -X POST http://localhost:4000/users/by-email \
  -H "Content-Type: application/json" \
  -d '{"email": "john@example.com", "name": "John Doe"}'
