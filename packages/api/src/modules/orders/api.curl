# List All Orders
curl -X GET http://localhost:4000/orders

# Create Order
curl -X POST http://localhost:4000/orders \
  -H "Content-Type: application/json" \
  -d '{"user_id": 1, "item_id": 1, "quantity": 2, "date": "2026-03-20"}'

# Get Order by ID
curl -X GET http://localhost:4000/orders/1

# Update Order
curl -X PUT http://localhost:4000/orders/1 \
  -H "Content-Type: application/json" \
  -d '{"user_id": 1, "item_id": 1, "quantity": 5, "date": "2026-03-21"}'

# Delete Order
curl -X DELETE http://localhost:4000/orders/1
